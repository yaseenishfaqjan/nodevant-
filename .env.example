# Copy to .env.local (for `npm run build`) or .env (for docker compose).
# These are PUBLIC build-time values inlined into the static site.

# 1) LEAD DELIVERY — where audit + contact leads are sent. Use ONE of:
#    - your n8n / Make / Zapier webhook URL, or
#    - https://api.web3forms.com/submit  (free form service)
NEXT_PUBLIC_LEAD_ENDPOINT=

# Only needed if using Web3Forms — your access key from web3forms.com
NEXT_PUBLIC_LEAD_ACCESS_KEY=

# 2) CAL.COM — your booking link, e.g. nodevant/strategy-call
NEXT_PUBLIC_CAL_LINK=nodevant/strategy-call

# 3) GOOGLE SEARCH CONSOLE — verification token (paste after adding the domain)
NEXT_PUBLIC_GSC_TOKEN=
