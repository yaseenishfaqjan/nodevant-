# Copy to .env (used by docker compose). Keep this file OUT of git (.gitignore).

# ── Frontend (build-time, inlined into the static site) ─────────────────────
# Leave LEAD_ENDPOINT empty to use the built-in backend at /api (recommended).
NEXT_PUBLIC_LEAD_ENDPOINT=
NEXT_PUBLIC_LEAD_ACCESS_KEY=
NEXT_PUBLIC_CAL_LINK=nodevant-strategy-call/30min
NEXT_PUBLIC_GSC_TOKEN=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (optional)
NEXT_PUBLIC_GA_ID=

# ── Database (Postgres) ─────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-strong-db-password

# ── Backend API (nodevant-api) ──────────────────────────────────────────────
# CRM admin token — used to log into /admin. Make it long & random.
ADMIN_TOKEN=change-me-long-random-admin-token

# Reverse Audit scanner (/api/reverse-audit/scan).
# LEAVE OPENAI_API_KEY BLANK to run in HYBRID/manual mode: the scan queues a
# hands-on audit for the team and captures the visitor's email (no cost, no key).
# SET it to run the instant AI scan. Model defaults to gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# cPanel SMTP — sends the audit report to leads + notifies you.
SMTP_HOST=mail.nodevant.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@nodevant.com
SMTP_PASS=your-mailbox-password
MAIL_FROM_NAME=Nodevant
# info@ (SMTP_USER) is ALWAYS notified of every lead. LEAD_NOTIFY_TO adds
# EXTRA recipients on the To: line (comma-separated). LEAD_NOTIFY_BCC adds
# silent backup copies (comma-separated) — e.g. a personal Gmail for redundancy.
LEAD_NOTIFY_TO=sales@nodevant.com
LEAD_NOTIFY_BCC=
SITE_URL=https://nodevant.com

# Cal.com booking webhook secret (any random string). Add the webhook in Cal.com:
#   Settings -> Developer -> Webhooks -> URL:
#   https://nodevant.com/api/cal-webhook?key=THIS_VALUE  (subscribe to BOOKING_CREATED)
CAL_WEBHOOK_SECRET=

# Voice agent (Alex / VAPI) webhook secret. Point VAPI's server URL (or a
# capture_lead tool) at: https://nodevant.com/api/voice-lead?key=THIS_VALUE
VOICE_WEBHOOK_SECRET=
